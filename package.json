{
  "name": "buscaminas-tripartito",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "quality:lint": "npm --prefix client run lint",
    "quality:build": "npm --prefix client run build",
    "sonar:scan": "sonar-scanner-npm",
    "test:server": "npm --prefix server test",
    "test:coverage": "node server/node_modules/c8/bin/c8.js --reporter=text --reporter=lcov --reports-dir=server/coverage node --test server/test/**/*.test.js",
    "start:test-server": "PORT=${TEST_SERVER_PORT:-3001} CLIENT_URL=http://127.0.0.1:${TEST_CLIENT_PORT:-5173} npm --prefix server start",
    "start:test-client": "VITE_SERVER_URL=http://127.0.0.1:${TEST_SERVER_PORT:-3001} npm --prefix client run dev -- --host 127.0.0.1 --port ${TEST_CLIENT_PORT:-5173} --strictPort",
    "start:test-app": "concurrently --kill-others-on-fail \"npm run start:test-server\" \"npm run start:test-client\"",
    "test:e2e": "CYPRESS_baseUrl=http://127.0.0.1:${TEST_CLIENT_PORT:-5173} start-server-and-test \"npm run start:test-app\" \"http://127.0.0.1:${TEST_SERVER_PORT:-3001}|http://127.0.0.1:${TEST_CLIENT_PORT:-5173}\" \"cypress run\"",
    "test": "npm run test:server && npm run test:e2e",
    "redis:check": "redis-cli ping",
    "start:node:1": "NODE_ID=1 PORT=3001 npm --prefix server start",
    "start:node:2": "NODE_ID=2 PORT=3002 npm --prefix server start",
    "start:node:3": "NODE_ID=3 PORT=3003 npm --prefix server start",
    "start:cluster": "concurrently --kill-others-on-fail \"npm run start:node:1\" \"npm run start:node:2\" \"npm run start:node:3\""
  },
  "devDependencies": {
    "@sonar/scan": "^5.0.0",
    "concurrently": "^9.2.1",
    "cypress": "^15.20.1",
    "start-server-and-test": "^2.1.2"
  },
  "allowScripts": {
    "cypress@15.20.1": true
  }
}
